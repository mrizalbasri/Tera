APP_NAME=Expense Agent API
ENVIRONMENT=development
# Local demo only: skips Clerk, forces isolated memory storage and mock providers.
DEMO_MODE=false
FRONTEND_ORIGIN=http://localhost:5173
# HS256 JWT secret key (must be at least 32 characters in production).
SECRET_KEY=change_this_to_a_secure_random_string_at_least_32_chars
# Comma-separated admin usernames. Empty means no admin access.
ADMIN_USERS=admin,reviewer,finance
STORAGE_BACKEND=memory
DATABASE_URL=postgresql+psycopg://postgres:change_me@127.0.0.1:5432/tera
# PostgreSQL checkpoint tables live in a schema separate from claim tables.
GRAPH_CHECKPOINT_SCHEMA=langgraph
# Legacy SQLite compatibility only; unused with PostgreSQL.
GRAPH_CHECKPOINT_PATH=./expense_agent_checkpoints.db
PROVIDER_MODE=mock

# Seed explicitly before switching to rag; no API key needed for embeddings.
POLICY_MODE=local
# Policy chunks/vectors use DATABASE_URL, separate from public/langgraph.
POLICY_INDEX_SCHEMA=rag
POLICY_MODEL_CACHE=./data/local/policy_model
# Reranking is optional; explicitly seed --with-reranker before enabling it.
POLICY_RERANK_MODE=none
POLICY_RERANKER_CACHE=./data/local/policy_reranker
POLICY_TOP_K=8
POLICY_TOP_N=3
MAX_RECEIPT_SIZE_BYTES=10485760
MAX_RECEIPTS_PER_CLAIM=10
MAX_UPLOAD_TOTAL_BYTES=26214400
MAX_REQUEST_BYTES=27262976
CLAIM_LOCK_TIMEOUT_SECONDS=5
RECOVERY_INTERVAL_SECONDS=30
MAX_RECOVERY_ATTEMPTS=3
RATE_LIMIT_WRITE_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
AUTO_APPROVE_AMOUNT_LIMIT=500000
AUTO_APPROVE_MIN_CONFIDENCE=0.8
ESCALATION_AMOUNT_THRESHOLD=500000
MAX_PROCESSING_RETRIES=2
EXTRACTION_CONFIDENCE_THRESHOLD=0.8
MAX_CLAIM_AGE_DAYS=14
ANOMALY_ESCALATION_THRESHOLD=0.7
# Train explicitly before enabling ML, then restart the API.
ANOMALY_MODE=rules
ANOMALY_MODEL_PATH=./data/local/anomaly/model.joblib
LLM_BASE_URL=https://api.z.ai/api/paas/v4
LLM_MODEL=glm-4.5v
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
PROVIDER_FALLBACK=none
LLM_IMAGE_PRIVACY_MODE=send
