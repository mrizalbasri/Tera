ENVIRONMENT=production
DEMO_MODE=false
STORAGE_BACKEND=sql
DATABASE_URL=postgresql+psycopg://tera:REPLACE_WITH_DATABASE_PASSWORD@host.docker.internal:5432/tera
FRONTEND_ORIGIN=https://tera.example.com
SECRET_KEY=REPLACE_WITH_SECRET_KEY
ADMIN_USERS=admin,reviewer,finance
PROVIDER_MODE=live
PROVIDER_FALLBACK=none
LLM_BASE_URL=https://REPLACE_WITH_PROVIDER_ENDPOINT
LLM_MODEL=REPLACE_WITH_PROVIDER_MODEL
LLM_API_KEY=REPLACE_WITH_PROVIDER_KEY
LLM_IMAGE_PRIVACY_MODE=send
POLICY_MODE=local
ANOMALY_MODE=rules
MAX_CLARIFICATION_ROUNDS=3
